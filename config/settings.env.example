# Copy to config/settings.env, then: chmod 600 config/settings.env
# Base URL of myhome's direct API port (the add-on's 8000/tcp, not the HA ingress URL).
MYHOME_URL=http://homeassistant.local:8000
# API token created in myhome: Settings → Security & Access → API tokens, role "normal".
MYHOME_TOKEN=
# Optional
# CLAUDE_BIN=/root/.local/bin/claude
# TIMEOUT_S=1500
